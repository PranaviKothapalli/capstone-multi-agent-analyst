# --- LLM Provider: Groq (free tier) ---
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- System / Workspace ---
SYSTEM_WORKSPACE_DIR=./workspace/
LOGGING_LEVEL=INFO
SQLITE_DB_PATH=./workspace/metadata/audit_telemetry.db

# --- Dataset thresholds (optional overrides) ---
MIN_ROWS=5000
MAX_ROWS=150000
MAX_FILE_MB=200
